n91", "story_50486178", "front_page"], "author": "saikiran91", "children": [50487102, 50487139, 50487204, 50487210, 50487666, 50487900], "created_at": "2026-11-13T16:50:22Z", "created_at_i": 1794588622, "num_comments": 15, "objectID": "50486178", "points": 46, "story_id": 50486178, "title": "North Korean hackers used fake video calls in $400M crypto hack, says FBI", "updated_at": "2026-11-13T18:56:57Z", "url": "https://www.bbc.com/news/articles/cqdj1ellpd70o"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "halcdev"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "After 600 experiments, here's what I discovered about JEPA world models"}, "url": {"matchLevel": "none", "matchedWords": [], "value": "https://haddyalchaer.com/jepa"}}, "_tags": ["story", "author_halcdev", "story_50487185", "front_page"], "author": "halcdev", "children": [50487186, 50487874], "created_at": "2026-11-13T17:55:28Z", "created_at_i": 1794592528, "num_comments": 3, "objectID": "50487185", "points": 41, "story_id": 50487185, "title": "After 600 experiments, here's what I discovered about JEPA world models", "updated_at": "2026-11-13T18:58:07Z", "url": "https://haddyalchaer.com/jepa"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "marc__1"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "CERN Built the Large Hadron Collider's Next-Gen Magnets"}, "url": {"matchLevel": "none", "matchedWords": [], "value": "https://spectrum.ieee.org/large-hadron-collider-superconducting-magnets"}}, "_tags": ["story", "author_marc__1", "story_50483959", "front_page"], "author": "marc__1", "children": [50487172, 50487741, 50487999], "created_at": "2026-11-13T14:25:46Z", "created_at_i": 1794579946, "num_comments": 3, "objectID": "50483959", "points": 36, "story_id": 50483959, "title": "CERN Built the Large Hadron Collider's Next-Gen Magnets", "updated_at": "2026-11-13T18:58:07Z", "url": "https://spectrum.ieee.org/large-hadron-collider-superconducting-magnets"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "juscha1"}, "story_text": {"matchLevel": "none", "matchedWords": [], "value": "Technical Write-up: <a href=\"https://www.justinchavez.com/blog/isometric-sf-how/\" rel=\"nofollow\">https://www.justinchavez.com/blog/isometric-sf-how/</a><p>Hi HN! Showcasing this fun project. I took 1300 square miles of the SF Bay Area from Google Photorealistic 3D Tiles and transformed them into a cohesive pixel map. It's really fun to explore and stumble upon various famous landmarks like Apple Park, Palace of Fine Arts, or UC Berkeley.<p>The technicals involve using Nano Banana 2 to train a Qwen-Image-Edit 2511 LoRA which is used to prototype the style and generation methods. For final map I used Qwen to train a Klein 4B LoRA which reproduced the style at 1/4 of the cost. More details in the blog post.<p>Let me know what you think! I really enjoyed this process of fine-tuning smaller open source models.<p>If I did the map with Nano Banana 2 it would have cost around 7k USD!<p>Credit for the idea goes to Isometric NYC."}, "title": {"matchLevel": "none", "matchedWords": [], "value": "Show HN: Isometric SF – A pixel-art map of the SF Bay Area"}, "url": {"matchLevel": "none", "matchedWords": [], "value": "https://isometricsf.com/"}}, "_tags": ["story", "author_juscha1", "story_50487228", "show_hn", "front_page"], "author": "juscha1", "children": [50487635, 50487714, 50487747, 50487765, 50487783, 50487812, 50487887, 50487941], "created_at": "2026-11-13T17:58:37Z", "created_at_i": 1794592717, "num_comments": 11, "objectID": "50487228", "points": 27, "story_id": 50487228, "story_text": "Technical Write-up: <a href=\"https:&#x2F;&#x2F;www.justinchavez.com&#x2F;blog&#x2F;isometric-sf-how&#x2F;\" rel=\"nofollow\">https:&#x2F;&#x2F;www.justinchavez.com&#x2F;blog&#x2F;isometric-sf-how&#x2F;</a><p>Hi HN! Showcasing this fun project. I took 1300 square miles of the SF Bay Area from Google Photorealistic 3D Tiles and transformed them into a cohesive pixel map. It&#x27;s really fun to explore and stumble upon various famous landmarks like Apple Park, Palace of Fine Arts, or UC Berkeley.<p>The technicals involve using Nano Banana 2 to train a Qwen-Image-Edit 2511 LoRA which is used to prototype the style and generation methods. For final map I used Qwen to train a Klein 4B LoRA which reproduced the style at 1&#x2F;4 of the cost. More details in the blog post.<p>Let me know what you think! I really enjoyed this process of fine-tuning smaller open source models.<p>If I did the map with Nano Banana 2 it would have cost around 7k USD!<p>Credit for the idea goes to Isometric NYC.", "title": "Show HN: Isometric SF – A pixel-art map of the SF Bay Area", "updated_at": "2026-11-13T18:58:36Z", "url": "https://isometricsf.com/"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "BobaFloutist"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "It Takes 16 Clicks for a Student to Open a PowerPoint on an iPad"}, "url": {"matchLevel": "none", "matchedWords": [], "value": "https://www.reddit.com/r/Teachers/comments/1xuup7a/technology_sucks_it_literally_takes_16_clicks_for/"}}, "_tags": ["story", "author_BobaFloutist", "story_50487522", "front_page"], "author": "BobaFloutist", "children": [50488073, 50488082, 50488097], "created_at": "2026-11-13T18:18:37Z", "created_at_i": 1794593917, "num_comments": 3, "objectID": "50487522", "points": 20, "story_id": 50487522, "title": "It Takes 16 Clicks for a Student to Open a PowerPoint on an iPad", "updated_at": "2026-11-13T18:59:06Z", "url": "https://www.reddit.com/r/Teachers/comments/1xuup7a/technology_sucks_it_literally_takes_16_clicks_for/"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "sshah03"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "OpenAI disbands its robotics team as its general models star